# Public Mapbox token used only for rendering map tiles in the browser.
# This is a pk.* token (designed to be public); restrict it by URL in the
# Mapbox dashboard. Server-side Directions/Geocoding use MAPBOX_ACCESS_TOKEN
# in backend/.env and are never exposed to the frontend.
VITE_MAPBOX_TOKEN=pk.your_mapbox_token_here

# Base URL for the Django API. Leave unset in development (Vite proxies
# /api to localhost:8000). Set to the deployed API origin in production.
VITE_API_BASE_URL=
