DJANGO_SECRET_KEY=change-me-to-a-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Mapbox token used server-side for Directions and Geocoding APIs.
# Without this, route generation and geocoding will return a clear error;
# the risk engine and tests work independently of it.
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token_here

# Comma-separated frontend origins allowed by CORS (production URL).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
